<UserControl x:Class="Aracil_Victor_EcoCharger.Views.StationsCrudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aracil_Victor_EcoCharger.Views" xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <!-- Cargamos las Estaciones cuando se carga la Vista -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- DISEÑO PRINCIPAL -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <TextBlock Text="CRUD de Estaciones"
           FontSize="26"
           FontWeight="SemiBold"
           Foreground="#374151"
           Margin="0,0,0,20" 
           Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!-- Listado Estaciones -->
            <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,10,0"
                Grid.Column="0">

                <DockPanel>
                    <TextBlock Text="Estaciones" FontSize="18" DockPanel.Dock="Top" Margin="0,0,0,10"/>

                    <Button Content="Nueva Estacion" DockPanel.Dock="Bottom" Margin="0,10,0,0" Command="{Binding NuevaEstacionCommand}"/>

                    <ListBox Name="lbEstaciones" ItemsSource="{Binding ListaEstacionesVisibles}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" >
                        <!-- Indicamos al Binding, el elemento seleccionado para que se trabaje con el -->
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"  CommandParameter="{Binding ElementName=lbEstaciones, Path=SelectedItem}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Listado Cargadores -->
            <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,10,0"
                Grid.Column="2">

                <DockPanel>
                    <TextBlock Text="Cargadores" FontSize="18" DockPanel.Dock="Top" Margin="0,0,0,10"/>

                    <Button Content="Nuevo Cargador" DockPanel.Dock="Bottom" Margin="0,10,0,0" Command="{Binding NuevoCargadorCommand}"/>

                    <ScrollViewer>
                        <ListBox ItemsSource="{Binding Chargers}"
                            BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,4">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Tipo"/>
                                                <ComboBox Width="120" SelectedIndex="{Binding Type, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Type2_Mennekes" />
                                                    <ComboBoxItem Content="CHAdeMO" />
                                                    <ComboBoxItem Content="CCS2_Combo" />
                                                    <ComboBoxItem Content="Schuko" />
                                                </ComboBox>

                                                <CheckBox Content="Cargador Ocupado"
                                                    Margin="0,10,0,10"
                                                    IsChecked="{Binding IsOccupied, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                Content="❌"
                                                Margin="10,0,0,0"
                                                Command="{Binding DataContext.BorrarCargadorCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>


            <!-- Vista detalle Estacion -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Name="FormPanel" Margin="10">

                    <TextBlock Text="Detalle de la estacion:"
                   FontSize="20"
                   Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Path=Nombre}"
                   FontSize="15"
                   Margin="0,0,0,10"/>

                    <!-- Nombre -->
                    <TextBlock Text="Nombre"/>
                    <TextBox Text="{Binding Path=Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Dirección -->
                    <TextBlock Text="Dirección"/>
                    <TextBox Text="{Binding Path=Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Activa -->
                    <CheckBox Content="Tienda abierta" Margin="0,10,0,10" IsChecked="{Binding Path=IsActive}"/>

                    <!-- ACCIONES -->
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                        <Button Content="Guardar"
                            Width="100"
                            Margin="0,0,10,0"
                            Command="{Binding DataContext.GuardarEstacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <Button Content="Eliminar"
                            Width="100"
                            Command="{Binding DataContext.BorrarEstacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
