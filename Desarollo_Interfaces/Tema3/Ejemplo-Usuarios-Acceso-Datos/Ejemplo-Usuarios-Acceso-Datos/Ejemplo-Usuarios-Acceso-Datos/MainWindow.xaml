<Window x:Class="Ejemplo_Usuarios_Acceso_Datos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejemplo_Usuarios_Acceso_Datos"
        mc:Ignorable="d"
        Title="Acceso a Datos de Usuario" Height="400" Width="600"  ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Columna izquierda: formularios -->
            <ColumnDefinition Width="*"/>
            <!-- Columna derecha: mostrar usuario -->
        </Grid.ColumnDefinitions>

        <!-- Columna Izquierda -->
        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Width="240">

            <!-- Formulario de búsqueda -->
            <GroupBox Header="Buscar Usuario" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <TextBlock Text="Nombre de usuario:" />
                    <TextBox Name="txtBuscarNombre" Width="200" Margin="0,5,0,10"/>
                    <Button Content="Buscar" Width="100" Click="Buscar_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Formulario para crear un nuevo usuario -->
            <GroupBox Header="Nuevo Usuario">
                <StackPanel Margin="10">
                    <TextBlock Text="Username:" />
                    <TextBox Name="txtNuevoUsername" Width="200" Margin="0,5,0,5"/>

                    <TextBlock Text="Nombre completo:" />
                    <TextBox Name="txtNuevoFullName" Width="200" Margin="0,5,0,5"/>

                    <TextBlock Text="Password:" />
                    <PasswordBox Name="txtNuevoPassword" Width="200" Margin="0,5,0,10"/>

                    <Button Content="Crear Usuario" Width="120" Click="Crear_Click"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>

        <!-- Columna Derecha -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <GroupBox Header="Usuario Encontrado" Width="300">
                <StackPanel Margin="10">
                    <TextBlock Text="ID:" FontWeight="Bold"/>
                    <TextBlock Name="lblId" Margin="0,0,0,10"/>

                    <TextBlock Text="Username:" FontWeight="Bold"/>
                    <TextBlock Name="lblUsername" Margin="0,0,0,10"/>

                    <TextBlock Text="Nombre completo:" FontWeight="Bold"/>
                    <TextBlock Name="lblFullName" Margin="0,0,0,10"/>

                    <TextBlock Text="Creado en:" FontWeight="Bold"/>
                    <TextBlock Name="lblCreatedAt" Margin="0,0,0,10"/>

                    <!-- Botones para Editar y Borrar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" >
                        <Button Content="Editar" Width="100" Margin="0,0,10,0" Click="Editar_Click"/>
                        <Button Content="Borrar" Width="100" Click="Borrar_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

    </Grid>
</Window>
