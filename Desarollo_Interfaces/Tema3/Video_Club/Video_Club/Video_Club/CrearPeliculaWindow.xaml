<Window x:Class="Video_Club.CrearPeliculaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Video_Club"
        mc:Ignorable="d"
            Title="Crear Película" Height="320" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="10">
        <GroupBox Header="Datos de la Nueva Pelicula" Margin="0,10,0,0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Título:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Name="txtTitulo" Grid.Row="0" Grid.Column="1" Margin="5"/>

                <Label Content="Director:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Name="txtDirector" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <Label Content="Año:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Name="txtYear" Grid.Row="2" Grid.Column="1" Margin="5"/>

                <Label Content="Categoria:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox Name="cmbCategoria" Grid.Row="3" Grid.Column="1" Margin="5"
                          SelectedIndex="0"
                          DisplayMemberPath="Clasificacion"
                          SelectedValuePath="Id"/>

                <Label Content="Cliente:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox Name="cmbCliente" Grid.Row="4" Grid.Column="1" Margin="5"
                          SelectedIndex="0"
                          DisplayMemberPath="Usuario"
                          SelectedValuePath="Id"/>

                <!-- BOTONES -->
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Name="btnGuardar" Content="Añadir Pelicula" Width="150" Height="30" Margin="10,0" Click="btnGuardar_Click"/>
                    <Button Name="btnCancelar" Content="Cerrar" Width="100" Height="30" Margin="10,0" Click="btnCancelar_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
