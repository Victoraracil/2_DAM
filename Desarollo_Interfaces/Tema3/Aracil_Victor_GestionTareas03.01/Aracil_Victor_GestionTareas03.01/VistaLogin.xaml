<Window x:Class="Aracil_Victor_GestionTareas03._01.VistaLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Aracil_Victor_GestionTareas03._01" mc:Ignorable="d" Title="VistaLogin" Height="550" Width="800" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True" MouseDown="Window_MouseDown">
    <Border Style="{StaticResource borderStyle1}">
        <Border CornerRadius="10" BorderThickness="0" Background="{StaticResource BrushFondoPanel}" Width="350" Height="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.2" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions><!-- Header Buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btn_Minimizar" Style="{StaticResource MinimizarBotonStyle}" Content="-" Grid.Column="1" Margin="0,0,5,0" Click="btn_Minimizar_Click"/>
                    <Button x:Name="btn_Close" Style="{StaticResource CerrarBotonStyle}" Content="X" Grid.Column="2" Click="btn_Close_Click"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                    <Image Source="/Imagenes/Logo.jpg" Width="80" Height="80" Margin="0,0,0,20"/>
                    <TextBlock Text="LOG IN" Foreground="{StaticResource BrushTextoPrincipal}" FontSize="24" FontWeight="Bold" FontFamily="Montserrat" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Bienvenido de nuevo" Foreground="{StaticResource BrushTextoSecundario}" FontSize="14" FontFamily="Montserrat" HorizontalAlignment="Center" Margin="0,0,0,30"/><!-- Usuario -->
                    <TextBlock Text="Nombre de Usuario" Foreground="{StaticResource BrushTextoPrincipal}" FontSize="12" FontWeight="Medium" FontFamily="Montserrat" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtUser" FontSize="14" FontWeight="Medium" Foreground="{StaticResource BrushTextoPrincipal}" CaretBrush="{StaticResource BrushPrincipalNaranja}" BorderBrush="{StaticResource BrushTextoPrincipal}" BorderThickness="0,0,0,1" Height="30" VerticalContentAlignment="Center" Padding="25,0,0,0" Background="Transparent"></TextBox>
                    <!-- Icono superpuesto (simulado con margen negativo o grid, aquí simplificado si no hay icono en código original, pero había ImageBrush) -->
                    <!-- El original usaba ImageBrush en Background. Vamos a mantenerlo simple o usar un Grid si queremos icono. -->
                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Foreground="{StaticResource BrushTextoPrincipal}" FontSize="12" FontWeight="Medium" FontFamily="Montserrat" Margin="0,20,0,5"/>
                    <PasswordBox x:Name="txtPass" FontSize="14" FontWeight="Medium" Foreground="{StaticResource BrushTextoPrincipal}" CaretBrush="{StaticResource BrushPrincipalNaranja}" BorderBrush="{StaticResource BrushTextoPrincipal}" BorderThickness="0,0,0,1" Height="30" VerticalContentAlignment="Center" Padding="25,0,0,0" Background="Transparent"/><!-- Botón Login -->
                    <Button x:Name="btn_Login" Content="LOG IN" Foreground="White" FontSize="14" FontFamily="Montserrat" FontWeight="Bold" Cursor="Hand" Margin="0,40,0,0" Height="40" Click="btn_Login_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource BrushPrincipalNaranja}" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="¿Has olvidado tu contraseña?" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontFamily="Montserrat"/>
                        <TextBlock Text="Recuperar contraseña" Foreground="{StaticResource BrushPrincipalNaranja}" FontSize="11" FontWeight="Bold" FontFamily="Montserrat" Cursor="Hand" TextDecorations="Underline" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>