<Window x:Class="Aracil_Victor_GestionTareas03._01.BajaUsuario" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="BajaUsuario" Height="450" Width="800" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True">
    <Border Style="{StaticResource borderStyle1}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions><!-- Criterios arriba (búsqueda incremental) -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="8" Margin="0,0,0,10" BorderBrush="{StaticResource BrushTextoSecundario}" BorderThickness="1" CornerRadius="4" Background="{StaticResource BrushFondoPanel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Buscar usuarios activos:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <Label Content="Nombre:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBox x:Name="txtNombre" Width="240" Margin="4,0,12,0" TextChanged="txtNombre_TextChanged" ToolTip="Buscar por nombre y apellido"/>
                    <Label Content="Email:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBox x:Name="txtEmail" Width="260" Margin="4,0,0,0" TextChanged="txtEmail_TextChanged" ToolTip="Buscar por correo electrónico"/>
                </StackPanel>
            </Border><!-- Resultados a la izquierda -->
            <StackPanel Grid.Row="1" Grid.Column="0">
                <Grid Background="{StaticResource BrushFondoPanel}" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Usuario" FontWeight="Bold" Grid.Column="0" Margin="5,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBlock Text="Nombre" FontWeight="Bold" Grid.Column="1" Margin="5,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <TextBlock Text="Email" FontWeight="Bold" Grid.Column="2" Margin="5,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                </Grid>
                <ListBox x:Name="lbUsuarios" ItemsSource="{Binding UsuariosVisibles}" Height="320" IsSynchronizedWithCurrentItem="True" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Usuario}" Grid.Column="0" Margin="5,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                                <TextBlock Text="{Binding NombreCompleto}" Grid.Column="1" Margin="5,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                                <TextBlock Text="{Binding CorreoElectronico}" Grid.Column="2" Margin="5,0" Foreground="{StaticResource BrushTextoPrincipal}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel><!-- Detalle a la derecha -->
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BrushTextoSecundario}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="10,0,0,0" Background="{StaticResource BrushFondoPanel}">
                <StackPanel>
                    <TextBlock Text="Detalle (solo informativo antes de la baja)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="{StaticResource BrushTextoPrincipal}"/>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="ID:" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBox Text="{Binding SelectedItem.Id, ElementName=lbUsuarios, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Usuario:" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBox Text="{Binding SelectedItem.Usuario, ElementName=lbUsuarios, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Nombre y Apellido:" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBox Text="{Binding SelectedItem.NombreCompleto, ElementName=lbUsuarios, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Correo:" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBox Text="{Binding SelectedItem.CorreoElectronico, ElementName=lbUsuarios, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Activo:" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBox Text="{Binding SelectedItem.Activo, ElementName=lbUsuarios, Mode=OneWay}" IsReadOnly="True" Width="66" Height="22"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Fecha de baja:" FontWeight="Bold" Foreground="{StaticResource BrushTextoPrincipal}"/>
                        <TextBox Text="{Binding SelectedItem.FechaBaja, ElementName=lbUsuarios, Mode=OneWay, StringFormat=d}" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="btnDarBaja" Content="Dar de baja" Width="100" Click="btnDarBaja_Click" Style="{StaticResource CerrarBotonStyle}"/>
                        <Button Content="Cerrar" Width="80" Margin="8,0,0,0" Click="Close_Click" Style="{StaticResource BotonPrincipalStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>