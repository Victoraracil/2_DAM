<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><!-- Paleta de Colores -->
    <Color x:Key="ColorPrincipalNaranja">#FF7F57</Color><!-- Naranja Coral -->
    <Color x:Key="ColorHoverNaranja">#D85537</Color><!-- Naranja Quemado / Terracota -->
    <Color x:Key="ColorError">#8F240B</Color><!-- Rojo Vino Oscuro -->
    <Color x:Key="ColorTextoSecundario">#8B531E</Color><!-- Marrón Café -->
    <Color x:Key="ColorDecorativo">#FCD3A0</Color><!-- Melocotón / Crema -->
    <Color x:Key="ColorFondoPrincipal">#F3EFE1</Color><!-- Beige Claro -->
    <Color x:Key="ColorFondoPanel">#D0CDC1</Color><!-- Gris Taupe / Beige Oscuro -->
    <Color x:Key="ColorTextoPrincipal">#0F0F0F</Color><!-- Negro Carbón --><!-- Brushes -->
    <SolidColorBrush x:Key="BrushPrincipalNaranja" Color="{StaticResource ColorPrincipalNaranja}"/>
    <SolidColorBrush x:Key="BrushHoverNaranja" Color="{StaticResource ColorHoverNaranja}"/>
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="BrushTextoSecundario" Color="{StaticResource ColorTextoSecundario}"/>
    <SolidColorBrush x:Key="BrushDecorativo" Color="{StaticResource ColorDecorativo}"/>
    <SolidColorBrush x:Key="BrushFondoPrincipal" Color="{StaticResource ColorFondoPrincipal}"/>
    <SolidColorBrush x:Key="BrushFondoPanel" Color="{StaticResource ColorFondoPanel}"/>
    <SolidColorBrush x:Key="BrushTextoPrincipal" Color="{StaticResource ColorTextoPrincipal}"/><!-- Estilos Generales -->
    <Style x:Key="borderStyle1" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushFondoPrincipal}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <ImageBrush x:Key="usernameBackground" ImageSource="/Imagenes/User.jpg" Stretch="None" AlignmentX="Left"/>
    <ImageBrush x:Key="passBackground" ImageSource="/Imagenes/Pass.jpg" Stretch="None" AlignmentX="Left"/>
    <ControlTemplate x:Key="BotonCircularTemplate" TargetType="Button">
        <Border Width="18" Height="18" CornerRadius="9" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </ControlTemplate><!-- Botón Minimizar -->
    <Style x:Key="MinimizarBotonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource BotonCircularTemplate}"/>
        <Setter Property="Background" Value="{StaticResource BrushPrincipalNaranja}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHoverNaranja}"/>
            </Trigger>
        </Style.Triggers>
    </Style><!-- Botón Cerrar (basado en el Minimizar) -->
    <Style x:Key="CerrarBotonStyle" TargetType="Button" BasedOn="{StaticResource MinimizarBotonStyle}">
        <Setter Property="Background" Value="{StaticResource BrushError}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHoverNaranja}"/>
            </Trigger>
        </Style.Triggers>
    </Style><!-- Botón Principal -->
    <Style x:Key="BotonPrincipalStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushPrincipalNaranja}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="15,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushHoverNaranja}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>