<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Estilo basico de las paginas (margenes, botones, fondo, color, etc)-->

    <Style x:Key="borderStyle1" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="/Imagenes/Fondo.jpg" Stretch="None"/>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- Fondos -->
    <ImageBrush x:Key="usernameBackground" ImageSource="/Imagenes/User.jpg" Stretch="None" AlignmentX="Left"/>
    <ImageBrush x:Key="passBackground" ImageSource="/Imagenes/Pass.jpg" Stretch="None" AlignmentX="Left"/>

</ResourceDictionary>