<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorPrincipalNaranja">#F96A4C</Color>
    <Color x:Key="ColorHoverNaranja">#D55C41</Color>
    <Color x:Key="ColorFondoPrincipal">#C9A99F</Color>
    <Color x:Key="ColorFondoLateral">#FFFDF9</Color>
    <Color x:Key="ColorTextoPrincipal">#292523</Color>

    <SolidColorBrush x:Key="BrushPrincipalNaranja" Color="{StaticResource ColorPrincipalNaranja}"/>
    <SolidColorBrush x:Key="BrushHoverNaranja" Color="{StaticResource ColorHoverNaranja}"/>
    <SolidColorBrush x:Key="BrushFondoPrincipal" Color="{StaticResource ColorFondoPrincipal}"/>
    <SolidColorBrush x:Key="BrushFondoLateral" Color="{StaticResource ColorFondoLateral}"/>
    <SolidColorBrush x:Key="BrushTextoPrincipal" Color="{StaticResource ColorTextoPrincipal}"/>

    <Style x:Key="borderStyle1" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="/Imagenes/Fondo.jpg"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <ImageBrush x:Key="usernameBackground" ImageSource="/Imagenes/User.jpg" Stretch="None" AlignmentX="Left"/>
    <ImageBrush x:Key="passBackground"  ImageSource="/Imagenes/Pass.jpg" Stretch="None" AlignmentX="Left"/>

    <ControlTemplate x:Key="BotonCircularTemplate" TargetType="Button">
        <Border Width="18" Height="18"
                CornerRadius="9"
                Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
        </Border>
    </ControlTemplate>


    <!-- Botón Minimizar -->
    <Style x:Key="MinimizarBotonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Montserrat"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource BotonCircularTemplate}"/>
        <Setter Property="Background" Value="{StaticResource BrushPrincipalNaranja}"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHoverNaranja}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Botón Cerrar (basado en el Minimizar) -->
    <Style x:Key="CerrarBotonStyle" TargetType="Button"
           BasedOn="{StaticResource MinimizarBotonStyle}">
        <Setter Property="Background" Value="#824B3C"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHoverNaranja}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>