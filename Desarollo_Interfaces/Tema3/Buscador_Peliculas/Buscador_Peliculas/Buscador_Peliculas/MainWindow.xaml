<Window x:Class="Buscador_Peliculas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buscador_Peliculas"
        mc:Ignorable="d"
        Title="Buscador de Películas" Height="600" Width="1000" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Buscadores -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0" Grid.Column="0">
            <Label Content="Título:" FontWeight="Bold"/>
            <TextBox x:Name="txtTitulo" Width="200" Margin="0,0,10,0" 
                     TextChanged="Filtro_TextChanged"/>
            <Label Content="Director:" FontWeight="Bold"/>
            <TextBox x:Name="txtDirector" Width="200" Margin="0,0,10,0" 
                     TextChanged="Filtro_TextChanged"/>
            <Label Content="Año:" FontWeight="Bold"/>
            <TextBox x:Name="txtYear" Width="100" 
                     TextChanged="Filtro_TextChanged"/>
        </StackPanel>

        <!-- ListView con GridView -->
        <ListView x:Name="lvPeliculas" Grid.Row="1" Grid.Column="0" Margin="0,0,0,10" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                    <GridViewColumn Header="Título" DisplayMemberBinding="{Binding Titulo}" Width="180"/>
                    <GridViewColumn Header="Director" DisplayMemberBinding="{Binding Director}" Width="180"/>
                    <GridViewColumn Header="Año" DisplayMemberBinding="{Binding Year}" Width="80"/>
                    <GridViewColumn Header="Vista" DisplayMemberBinding="{Binding Vista}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ListBox con ItemTemplate -->
        <StackPanel Grid.Row="2" Grid.Column="0">
            <!-- Cabecera manual -->
            <Grid Background="#EEE" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Título" FontWeight="Bold" Grid.Column="0" Margin="5,0"/>
                <TextBlock Text="Director" FontWeight="Bold" Grid.Column="1" Margin="5,0"/>
                <TextBlock Text="Año" FontWeight="Bold" Grid.Column="2" Margin="5,0"/>
                <TextBlock Text="Vista" FontWeight="Bold" Grid.Column="3" Margin="5,0"/>
            </Grid>

            <ListBox x:Name="lbPeliculas" Height="220" ItemsSource="{Binding}" IsSynchronizedWithCurrentItem="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Titulo}" Grid.Column="0" Margin="5,0"/>
                            <TextBlock Text="{Binding Director}" Grid.Column="1" Margin="5,0"/>
                            <TextBlock Text="{Binding Year}" Grid.Column="2" Margin="5,0"/>
                            <CheckBox IsChecked="{Binding Path=Vista, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Content="Vista" Grid.Column="3" Margin="5,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Vista detalle -->
        <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="Detalle de la Película" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="Título:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Path=/Titulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="Director:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Path=/Director, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="Año:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Path=/Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Vista:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox IsChecked="{Binding Path=/Vista, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
