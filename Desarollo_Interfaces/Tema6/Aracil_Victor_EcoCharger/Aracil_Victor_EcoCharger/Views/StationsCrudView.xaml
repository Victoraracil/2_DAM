<UserControl x:Class="Aracil_Victor_EcoCharger.Views.StationsCrudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vr="clr-namespace:Aracil_Victor_EcoCharger.ValidationRules"
             xmlns:local="clr-namespace:Aracil_Victor_EcoCharger.Views" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <ControlTemplate x:Key="ValidationErrorTemplate">
            <DockPanel LastChildFill="True">

                <!-- Contenido principal -->
                <StackPanel>

                    <!-- Control adornado con borde completo -->
                    <Border
                        BorderBrush="#B71C1C"
                        BorderThickness="2"
                        CornerRadius="6">

                        <AdornedElementPlaceholder/>
                    </Border>

                    <!-- Caja de mensajes -->
                    <Border
                        Background="#1E1E1E"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,6,0,0"
                        MaxWidth="250">

                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                Text="{Binding ErrorContent}"
                                Foreground="#FFCDD2"
                                FontSize="12"
                                TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                </StackPanel>
            </DockPanel>
        </ControlTemplate>



        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <!-- Cargamos las Estaciones cuando se carga la Vista -->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!-- DISEÑO PRINCIPAL -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <TextBlock Text="CRUD de Estaciones"
           FontSize="26"
           FontWeight="SemiBold"
           Foreground="#374151"
           Margin="0,0,0,20" 
           Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!-- Listado Estaciones -->
            <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,10,0"
                Grid.Column="0">

                <DockPanel>
                    <TextBlock Text="Estaciones" FontSize="18" DockPanel.Dock="Top" Margin="0,0,0,10"/>

                    <Button Content="Nueva Estacion" DockPanel.Dock="Bottom" Margin="0,10,0,0" Command="{Binding NuevaEstacionCommand}"/>

                    <ListBox Name="lbEstaciones" ItemsSource="{Binding ListaEstacionesVisibles}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" >
                        <!-- Indicamos al Binding, el elemento seleccionado para que se trabaje con el -->
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}"  CommandParameter="{Binding ElementName=lbEstaciones, Path=SelectedItem}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Listado Cargadores -->
            <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,10,0"
                Grid.Column="2">

                <DockPanel>
                    <TextBlock Text="Cargadores" FontSize="18" DockPanel.Dock="Top" Margin="0,0,0,10"/>

                    <Button Content="Nuevo Cargador" DockPanel.Dock="Bottom" Margin="0,10,0,0" Command="{Binding NuevoCargadorCommand}"/>

                    <ScrollViewer>
                        <ListBox ItemsSource="{Binding Chargers}"
                            BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,4">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Tipo"/>
                                                <ComboBox Width="120" SelectedIndex="{Binding Type, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Type2_Mennekes" />
                                                    <ComboBoxItem Content="CHAdeMO" />
                                                    <ComboBoxItem Content="CCS2_Combo" />
                                                    <ComboBoxItem Content="Schuko" />
                                                </ComboBox>

                                                <!-- Potencia -->
                                                <TextBlock Text="Potencia"/>
                                                <TextBox Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
                                                    <TextBox.Text>
                                                        <Binding Path="MaxPower" UpdateSourceTrigger="LostFocus" ConverterCulture="es-ES">
                                                            <Binding.ValidationRules>
                                                                <vr:RangoPotenciaValidationRule Min="1" Max="350"/>
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                </TextBox>

                                                <CheckBox Content="Cargador Ocupado"
                                                    Margin="0,10,0,10"
                                                    IsChecked="{Binding IsOccupied, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                Content="❌"
                                                Margin="10,0,0,0"
                                                Command="{Binding DataContext.BorrarCargadorCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>


            <!-- Vista detalle Estacion -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Name="FormPanel" Margin="10">

                    <TextBlock Text="Detalle de la estacion:"
                   FontSize="20"
                   Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Path=Nombre}"
                   FontSize="15"
                   Margin="0,0,0,10"/>

                    <!-- Nombre -->
                    <TextBlock Text="Nombre"/>
                    <TextBox Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
                        <TextBox.Text>
                            <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <vr:StringValidationRule Texto="Nombre"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <!-- Dirección -->
                    <TextBlock Text="Dirección"/>
                    <TextBox Text="{Binding Path=Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Latitud -->
                    <TextBlock Text="Latitud"/>
                    <TextBox Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
                        <TextBox.Text>
                            <Binding Path="Latitude" UpdateSourceTrigger="LostFocus" ConverterCulture="es-ES">
                                <Binding.ValidationRules>
                                    <vr:RangoNumericoValidationRule Min="-90" Max="90"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <!-- Longitud -->
                    <TextBlock Text="Longitud"/>
                    <TextBox Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
                        <TextBox.Text>
                            <Binding Path="Longitude" UpdateSourceTrigger="LostFocus" ConverterCulture="es-ES">
                                <Binding.ValidationRules>
                                    <vr:RangoNumericoValidationRule Min="-180" Max="180"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <!-- Activa -->
                    <CheckBox Content="Tienda abierta" Margin="0,10,0,10" IsChecked="{Binding Path=IsActive}"/>

                    <!-- ACCIONES -->
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                        <Button Content="Guardar"
                            Width="87"
                            Margin="0,0,10,0"
                            Command="{Binding DataContext.GuardarEstacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                        <Button Content="Eliminar"
                            Width="87"
                            Command="{Binding DataContext.BorrarEstacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
